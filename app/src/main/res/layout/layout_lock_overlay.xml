// File #9: /app/src/main/res/layout/layout_lock_overlay.xml
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivLock"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true"
        android:src="@drawable/ic_lock_red" />

    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔴 LOCKED V2"
        android:textColor="#FF0000"
        android:textSize="48sp"
        android:textStyle="bold"
        android:layout_below="@id/ivLock"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/tvLockSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alert Message Here"
        android:textColor="#FF4444"
        android:textSize="28sp"
        android:layout_below="@id/tvLockTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />
</RelativeLayout>